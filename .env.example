# StackLive External App Configuration
# Copy this file to .env and fill in your actual values from https://stacklive.io/developer

# Developer ID - Get this from the Developer Portal after registration
VITE_STACKLIVE_DEVELOPER_ID=your_developer_id_here

# API Key - Use test key for development, live key for production
# Format: sl_test_... (test) or sl_live_... (production)
VITE_STACKLIVE_API_KEY=sl_test_your_api_key_here

# StackLive API Base URL
VITE_STACKLIVE_API_URL=https://api.stacklive.io/v1

# Optional: Enable bridge mode for StackLive context delivery
VITE_BRIDGE_ENABLED=true
